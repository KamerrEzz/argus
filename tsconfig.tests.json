{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@acr/config": ["packages/config/src/index.ts"],
      "@acr/shared": ["packages/shared/src/index.ts"],
      "@acr/database": ["packages/database/src/index.ts"],
      "@acr/github": ["packages/github/src/index.ts"],
      "@acr/sandbox": ["packages/sandbox/src/index.ts"],
      "@acr/queue": ["packages/queue/src/index.ts"],
      "@acr/ai": ["packages/ai/src/index.ts"],
      "@acr/pipeline": ["packages/pipeline/src/index.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/test/**/*.ts",
    "apps/web/e2e/**/*.ts",
    "tests/**/*.ts"
  ]
}
