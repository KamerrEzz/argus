{
  "name": "ai-code-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Pull Request review and QA platform",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @acr/api",
    "dev:worker": "npm run dev -w @acr/worker",
    "dev:web": "npm run dev -w @acr/web",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose down",
    "build": "npm run db:generate && npm run build:backend && npm run build:web",
    "build:backend": "tsc -b tsconfig.build.json",
    "build:packages": "tsc -b tsconfig.packages.json",
    "build:web": "npm run build -w @acr/web",
    "typecheck": "tsc -b tsconfig.build.json --force && npm run typecheck -w @acr/web",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run db:generate && vitest run",
    "test:unit": "npm run db:generate && vitest run --project unit",
    "test:integration": "npm run db:generate && vitest run --project integration",
    "test:e2e": "npm run db:generate && vitest run --project e2e",
    "test:e2e:web": "playwright test",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @acr/database",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema packages/database/prisma/schema.prisma",
    "db:seed": "npm run db:seed -w @acr/database",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "review": "npm run review -w @acr/cli --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
