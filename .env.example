# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Pretty logs need pino-pretty, which is a dev dependency: production images do
# not carry it and fall back to JSON. Keep this false outside local development.
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
AUTH_SESSION_TTL_MINUTES=720
AUTH_COOKIE_NAME=acr_session
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
BOOTSTRAP_ADMIN_NAME=Admin

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://acr:acr@localhost:5432/acr?schema=public
DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=acr

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
QUEUE_REVIEW_CONCURRENCY=2
QUEUE_COMMAND_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
QUEUE_JOB_TIMEOUT_MS=1800000
QUEUE_EVENT_STREAM_MAXLEN=1000
# inline = run checks in the reviewing process (API or worker) through the configured sandbox; queued = dispatch run-tests / run-static-analysis jobs to the worker queue (requires Redis)
REVIEW_COMMAND_EXECUTION=inline

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents (escaped newlines allowed) or a path to a .pem file
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Optional fallback token for repositories without an App installation (local development only)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN_CACHE_SKEW_SECONDS=60
GITHUB_REQUEST_TIMEOUT_MS=20000
GITHUB_MAX_PAGES=10

# ---------------------------------------------------------------------------
# LLM provider (OpenAI-compatible API surface)
# ---------------------------------------------------------------------------
# Named providers carry a default base URL, so LLM_BASE_URL can stay empty:
#   openai        -> https://api.openai.com/v1
#   openrouter    -> https://openrouter.ai/api/v1   (model ids like "openai/gpt-4o")
#   nan-builders  -> https://api.nan.builders/v1    (model ids like "glm5.3-flash")
# openai-compatible has no default: set LLM_BASE_URL to your gateway.
# An explicit LLM_BASE_URL always overrides the provider preset.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4000
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_INPUT_COST_PER_1K_USD=0
LLM_OUTPUT_COST_PER_1K_USD=0
# OpenRouter app attribution (optional; sent only when LLM_PROVIDER=openrouter)
LLM_HTTP_REFERER=
LLM_APP_TITLE=

# ---------------------------------------------------------------------------
# Secure code execution sandbox
# ---------------------------------------------------------------------------
# docker | process   (process is a local fallback that still uses a child process)
SANDBOX_MODE=docker
SANDBOX_IMAGE=node:22-bookworm-slim
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT_MS=600000
SANDBOX_NETWORK=none
ALLOW_PROCESS_SANDBOX=false
WORKSPACE_ROOT=.work
GIT_CLONE_DEPTH=50
GIT_BINARY=git
DOCKER_BINARY=docker

# ---------------------------------------------------------------------------
# Review budgets and publishing policy
# ---------------------------------------------------------------------------
REVIEW_MAX_DURATION_MS=900000
REVIEW_MAX_FILES=50
REVIEW_MAX_TOKENS=200000
REVIEW_MAX_TOOL_CALLS=60
REVIEW_MAX_AGENT_ITERATIONS=12
REVIEW_MAX_DIFF_BYTES=400000
REVIEW_MAX_FILE_BYTES=200000
REVIEW_MIN_PUBLISH_CONFIDENCE=0.6
REVIEW_PUBLISH_ENABLED=true
REVIEW_CHECK_RUN_ENABLED=true
REVIEW_REQUIRE_APPROVAL_FOR_PUBLISH=false

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=AI Code Review
